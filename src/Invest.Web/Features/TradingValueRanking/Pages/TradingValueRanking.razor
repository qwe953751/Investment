@page "/trading-value-ranking"

@using Invest.Web.Features.TradingValueRanking.Components
@using Invest.Web.Infrastructure.MarketData

@inject TradingValueRankingQueryService RankingService

<PageTitle>個股成交值排行</PageTitle>

<div class="ranking-page">
    <header class="page-header">
        <h1>個股成交值排行</h1>
        <p>
            資料來源為證交所與櫃買中心的每日收盤行情，只計一般交易、只收個股（不含 ETF 與權證），
            所有數字都由原始成交值即時計算。
        </p>
    </header>

    @if (_loading)
    {
        <section class="notice">行情載入中…</section>
    }
    else if (_result is null)
    {
        <section class="notice">尚未載入資料。</section>
    }
    else if (!_result.HasSufficientData)
    {
        <section class="notice warning">
            @_result.InsufficientDataMessage
            <br />
            執行 <code>dotnet run --project src/Invest.Web -- backfill 120</code> 可以再往回補資料。
        </section>
    }
    else
    {
        <section class="summary">
            @if (_result.MarketHeat is { } heat)
            {
                <section class="market-heat-panel">
                    <div class="market-heat-overview">
                        <div class="market-heat-heading">
                            <span class="market-heat-title"
                                  data-hint="熱絡分數由短期趨勢 35%、參與廣度 35%、量能 30% 加權而成。每項先換算為 0～10 分，畫面顯示四捨五入後的整數；它是市場狀態參考，不是買賣訊號。">
                                市場熱絡程度 · 盤後
                            </span>
                            <strong class="market-heat-score">@HeatScoreText(heat.Score)/10</strong>
                            <span class="market-heat-level @HeatLevelClass(heat.Score)">@HeatLevelText(heat.Score)</span>
                        </div>

                        <div class="market-heat-progress"
                             data-hint="分數越接近 10，代表趨勢、上漲參與與成交量同時偏強；越接近 0 則代表整體偏冷。">
                            <span class="market-heat-progress-fill @HeatLevelClass(heat.Score)"
                                  style="width:@HeatProgressWidth(heat.Score)"></span>
                        </div>

                        <div class="market-heat-scale">
                            <span class="market-heat-scale-cold">冷清</span>
                            <span class="market-heat-scale-neutral">中性</span>
                            <span class="market-heat-scale-hot">熱絡</span>
                        </div>

                        <div class="market-heat-history">
                            <span class="market-heat-history-title"
                                  data-hint="只顯示所選日期之前的最近 5 個交易日，不把當天重複放進歷史分數；圓點內同樣只顯示四捨五入後的整數。">
                                前 5 日分數
                            </span>
                            @foreach (var day in heat.PreviousDays.OrderByDescending(day => day.TradingDate))
                            {
                                <span class="market-heat-history-item"
                                      data-hint="@($"{day.TradingDate:yyyy/MM/dd} 的市場熱絡分數：{HeatScoreText(day.Score)}/10。")">
                                    <strong class="market-heat-history-score">@HeatScoreText(day.Score)</strong>
                                    <small>@day.TradingDate.ToString("MM/dd")</small>
                                </span>
                            }
                            @if (heat.PreviousDays.Count == 0)
                            {
                                <span class="market-heat-history-empty">尚無前五日資料</span>
                            }
                        </div>
                    </div>

                    <div class="market-heat-indicators">
                        <div class="market-heat-card">
                            <div class="market-heat-card-title"
                                 data-hint="短期趨勢分數：先取加權與櫃買指數的平均日漲跌，再以最近五個交易日的平均方向補充；日／週分別占 60%／40%，最後換成 0～10 分。">
                                <span>短期趨勢</span><strong>@HeatScoreText(heat.ShortTrendScore) 分</strong>
                            </div>
                            @{ var twseIndex = SelectedMarketIndices.FirstOrDefault(item => item.Market == Market.Twse); }
                            <div class="market-heat-card-value @RankingFormatter.ToTrendCssClass(IndexChangeRate(twseIndex))">
                                加權 @RankingFormatter.ToSignedPercentText(IndexChangeRate(twseIndex), 2)
                            </div>
                        </div>

                        <div class="market-heat-card">
                            <div class="market-heat-card-title"
                                 data-hint="參與廣度分數：逐檔比較當日收盤與前一個有效收盤；上漲減下跌後除以可比較檔數，再換成 0～10 分。沒有前收的標的不列入分母。">
                                <span>參與廣度</span><strong>@HeatScoreText(heat.BreadthScore) 分</strong>
                            </div>
                            <div class="market-heat-card-value market-heat-breadth-value">
                                <span class="market-heat-up-count">上漲 @heat.UpCount 檔</span>
                                <span class="market-heat-down-count">下跌 @heat.DownCount 檔</span>
                            </div>
                        </div>

                        <div class="market-heat-card">
                            <div class="market-heat-card-title"
                                 data-hint="量能分數：當日上市＋上櫃成交值，除以之前最多 20 個交易日的日均成交值；1.00 倍是中性 5 分，每增加 0.10 倍增加 1 分，最後限制在 0～10 分。">
                                <span>量能</span><strong>@HeatScoreText(heat.VolumeScore) 分</strong>
                            </div>
                            <div class="market-heat-card-value">@HeatVolumeText(heat.VolumeRatio)</div>
                        </div>
                    </div>

                    <div class="market-heat-indices">
                        @foreach (var (market, label) in MarketIndexDefinitions)
                        {
                            var index = SelectedMarketIndices.FirstOrDefault(item => item.Market == market);
                            var dailyRate = IndexChangeRate(index);
                            var yearToDateRate = IndexYearToDateRate(index);

                            <div class="market-heat-index-card">
                                <div class="market-heat-index-title"
                                     data-hint="@($"{label}的所選交易日收盤指數；上層顯示日漲跌幅與變動點數，下層顯示今年截至該日的漲跌幅與變動點數。")">
                                    <span>@label</span><span>示意</span>
                                </div>
                                <strong class="market-heat-index-value">@IndexValueText(index)</strong>
                                <div class="market-heat-index-changes">
                                    <span class="market-heat-index-daily @RankingFormatter.ToTrendCssClass(dailyRate)">
                                        日 @RankingFormatter.ToSignedPercentText(dailyRate, 2)@IndexPointSuffix(index, dailyRate)
                                    </span>
                                    <span class="market-heat-index-year @RankingFormatter.ToTrendCssClass(yearToDateRate)">
                                        今年 @RankingFormatter.ToSignedPercentText(yearToDateRate, 2)@IndexPointSuffix(index, yearToDateRate)
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="market-heat-meta">
                        <div><span>交易日</span><strong>@heat.TradingDate.ToString("yyyy/MM/dd")</strong></div>
                        <div><span>資料時間</span><strong>盤後資料</strong></div>
                        <div><span>時段進度</span><strong>已收盤</strong></div>
                        <div>
                            <span data-hint="全市場成交額是上市與上櫃一般交易的正式合計；盤後不與前一交易日比較。">全市場成交額</span>
                            <strong>@HeatTurnoverText(heat.MarketTurnover) 億元</strong>
                        </div>
                    </div>
                </section>
            }

            <div class="summary-row summary-explanation-row">
                <div>
                    <span class="summary-label">本期</span>
                    @RankingFormatter.ToPeriodText(_result.CurrentPeriodStart, _result.CurrentPeriodEnd)
                </div>
                <div>
                    <span class="summary-label">前期</span>
                    @RankingFormatter.ToPeriodText(_result.PreviousPeriodStart, _result.PreviousPeriodEnd)
                </div>
                <div>
                    <span class="summary-label">全市場日均成交值</span>
                    @RankingFormatter.ToBillionText(_result.MarketTotalTradingValue / _result.PeriodDays, 0) 億元
                </div>
                <div>
                    <span class="summary-label">符合條件</span>
                    @_result.RankedStockCount 檔，顯示前 @_result.Rows.Count 名
                </div>
            </div>
        </section>

        <section class="filter-panel">
            <div class="filter-group">
                <span class="filter-label" data-hint="本期的長度。前期固定採緊鄰的同長度區間，例如近 20 日 vs 再往前 20 日。">觀察期間</span>
                <div class="button-row">
                    @foreach (var (period, text, hint) in PeriodOptions)
                    {
                        <button type="button"
                                class="@ToggleClass(period == _query.PeriodDays)"
                                data-hint="@hint"
                                @onclick="() => ChangePeriodAsync(period)">
                            @text
                        </button>
                    }
                </div>
            </div>

            <div class="filter-group">
                <span class="filter-label" data-hint="觀察期間的最後一天。往回選一天，該日之後的行情就完全不列入計算，看到的是當天收盤後的排行。">交易日</span>
                <TradingDatePicker AvailableDates="_tradingDates"
                                   Value="_query.EndDate"
                                   ValueChanged="ChangeEndDateAsync" />
            </div>

            <div class="filter-group">
                <span class="filter-label" data-hint="決定排行榜依哪個數字排序。">排行模式</span>
                <div class="button-row">
                    <button type="button"
                            class="@ToggleClass(_query.Mode == RankingMode.TradingHeat)"
                            data-hint="依本期平均每日成交值排序，回答「最近哪些標的吸收最多成交值」。需要 2N 個交易日。"
                            @onclick="() => ChangeModeAsync(RankingMode.TradingHeat)">
                        成交熱度
                    </button>
                    <button type="button"
                            class="@ToggleClass(_query.Mode == RankingMode.CapitalAcceleration)"
                            data-hint="依成交值增減率排序，回答「哪些標的的成交值相較前期快速放大」。前期排名本身也是增減率，所以需要 3N 個交易日。"
                            @onclick="() => ChangeModeAsync(RankingMode.CapitalAcceleration)">
                        資金加速
                    </button>
                </div>
            </div>

            <div class="filter-group">
                <span class="filter-label" data-hint="只篩選要看的市場。市場成交比的分母不受影響，一律是上市＋上櫃全體。">市場</span>
                <div class="button-row">
                    @foreach (var (filter, text) in MarketOptions)
                    {
                        <button type="button"
                                class="@ToggleClass(_query.Market == filter)"
                                @onclick="() => ChangeMarketAsync(filter)">
                            @text
                        </button>
                    }
                </div>
            </div>

            <div class="filter-group">
                <span class="filter-label" data-hint="「平均每日成交值」的下限，單位就是表格上那一欄。主要是為了資金加速：冷門股從幾十萬跳到幾百萬就是好幾倍成長，不過濾的話排行榜會被這類標的佔滿。">成交門檻</span>
                <div class="button-row">
                    @foreach (var threshold in LiquidityOptions)
                    {
                        <button type="button"
                                class="@ToggleClass(_query.MinimumAverageDailyTradingValue == threshold)"
                                data-hint="@ToThresholdHint(threshold)"
                                @onclick="() => ChangeLiquidityAsync(threshold)">
                            @RankingFormatter.ToThresholdText(threshold)
                        </button>
                    }

                    @* 按鈕之外的任意金額。單位與按鈕一樣是平均每日成交值。 *@
                    <span class="threshold-custom">
                        <input type="number" class="threshold-input" min="0" step="0.1"
                               data-hint="自己輸入金額，單位與按鈕相同：平均每日成交值（億元）"
                               placeholder="自訂" value="@CustomThresholdText"
                               @onchange="ChangeCustomLiquidityAsync" />
                        <span class="threshold-unit">億元</span>
                    </span>
                </div>
            </div>

            <div class="filter-group">
                <span class="filter-label" data-hint="輸入股號追蹤個股。鎖定的標的會顯示目前名次並在排行榜上整列標色；名次是通過市場與門檻篩選後的完整名次，掉出前 100 名也看得到。">鎖定</span>
                <div class="lock-row">
                    <input type="text" class="lock-input" placeholder="股號" maxlength="6" inputmode="numeric"
                           @bind="_lockInput" @bind:event="oninput" @onkeydown="LockKeyDown" />
                    <button type="button" class="icon-button" data-hint="加入鎖定" @onclick="AddLock">＋</button>

                    @if (_lockedTickers.Count > 0)
                    {
                        <button type="button" class="icon-button danger" data-hint="全部清除"
                                @onclick="ClearLocks">✕</button>
                    }

                    @if (_lockError is not null)
                    {
                        <span class="lock-error">@_lockError</span>
                    }

                    @foreach (var ticker in _lockedTickers)
                    {
                        <span class="lock-chip">
                            <span class="lock-chip-ticker">@ticker</span>
                            <span class="lock-chip-name">@_stockNames.GetValueOrDefault(ticker)</span>
                            <span class="lock-chip-rank">@LockedRankText(ticker)</span>
                            <button type="button" class="lock-chip-remove" data-hint="取消鎖定"
                                    @onclick="() => _lockedTickers.Remove(ticker)">×</button>
                        </span>
                    }
                </div>
            </div>
        </section>

        <div class="table-container">
            <table class="ranking-table">
                <thead>
                    <tr>
                        @foreach (var column in Columns)
                        {
                            <th class="@HeaderClass(column)" data-hint="@column.Hint"
                                @onclick="() => SortBy(column)">
                                @column.Title@SortIndicator(column)
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in SortedRows)
                    {
                        <tr class="@(_lockedTickers.Contains(row.Ticker) ? "locked" : null)">
                            <td class="rank">@row.Rank</td>

                            <td class="@RankingFormatter.ToTrendCssClass(row.RankChange)">
                                @RankingFormatter.ToRankChangeText(row.RankChange)
                            </td>

                            <td class="ticker">
                                @row.Ticker<span class="market-mark" data-hint="@RankingFormatter.ToMarketText(row.Market)">@RankingFormatter.ToMarketMark(row.Market)</span>
                            </td>
                            <td class="stock-name">
                                <button type="button" class="stock-name-button"
                                        aria-expanded="@(_expandedTicker == row.Ticker)"
                                        data-hint="點擊開啟這檔標的最近三個月還原權息日 K"
                                        @onclick="() => ToggleKLine(row.Ticker)">
                                    @row.Name
                                </button>
                            </td>
                            <td class="numeric">@RankingFormatter.ToBillionText(row.AverageDailyTradingValue)</td>

                            <td class="numeric @RankingFormatter.ToTrendCssClass(row.TradingValueChangeRate)">
                                @RankingFormatter.ToSignedPercentText(row.TradingValueChangeRate)
                            </td>

                            <td class="numeric">@RankingFormatter.ToPercentText(row.MarketShare)</td>

                            <td class="numeric @RankingFormatter.ToTrendCssClass(row.MarketShareChange)">
                                @RankingFormatter.ToSignedPercentText(row.MarketShareChange, 2)
                            </td>

                            <td class="numeric metric-stack price-change">
                                <span class="metric-line metric-primary @RankingFormatter.ToTrendCssClass(row.DailyPriceChangeRate)">
                                    <span class="metric-label">日</span>@RankingFormatter.ToSignedPercentText(row.DailyPriceChangeRate)
                                </span>
                                <span class="metric-line metric-secondary @RankingFormatter.ToTrendCssClass(row.WeeklyPriceChangeRate)">
                                    <span class="metric-label">週</span>@RankingFormatter.ToSignedPercentText(row.WeeklyPriceChangeRate)
                                </span>
                            </td>

                            <td class="numeric">@(row.ClosePrice?.ToString("N2") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ExpandedKLineRow is { } klineRow)
        {
            <div class="kline-backdrop" @onclick="CloseKLine"></div>
            <section class="kline-popover" role="dialog" aria-modal="false"
                     aria-label="@($"{klineRow.Ticker} {klineRow.Name} 還原權息日 K")">
                <DailyKLineChart Ticker="@klineRow.Ticker"
                                 Name="@klineRow.Name"
                                 EndDate="@KLineEndDate"
                                 Bars="@KLineBars(klineRow.Ticker)"
                                 OnClose="CloseKLine" />
            </section>
        }

        <footer class="page-footer">
            <p>成交值只計一般交易，零股、盤後定價與鉅額交易都已逐檔扣除，與玩股網、籌碼K 的成交值排行一致。</p>
            <p>市場成交比的分母一律是上市＋上櫃全體，不隨市場篩選改變，因此切換市場時比例可以直接互相比較。</p>
            <p>成交門檻是為了資金加速模式：冷門股從幾十萬跳到幾百萬就是好幾倍成長，不過濾的話排行榜沒有參考價值。</p>
            <p>期間漲跌以進入期間前的最後一個收盤價為基準，所以期間內第一天的漲跌也算在內。</p>
            <p>加權指數與櫃買指數是所選交易日的收盤值；括號內為相對前一交易日收盤的漲跌幅。</p>
        </footer>
    }
</div>

@code {
    private static readonly (int Days, string Text, string Hint)[] PeriodOptions =
    [
        (1, "前一交易日", "基準日當天，與前一個交易日比較。當日盤中資料之後再做。"),
        (5, "5 日", "最近 5 個交易日 vs 再往前 5 個交易日"),
        (10, "10 日", "最近 10 個交易日 vs 再往前 10 個交易日"),
        (20, "20 日", "最近 20 個交易日 vs 再往前 20 個交易日"),
        (60, "60 日", "最近 60 個交易日 vs 再往前 60 個交易日")
    ];

    private static readonly (MarketFilter Filter, string Text)[] MarketOptions =
    [
        (MarketFilter.All, "全部"),
        (MarketFilter.Twse, "上市"),
        (MarketFilter.Tpex, "上櫃")
    ];

    private static readonly (Market Market, string Label)[] MarketIndexDefinitions =
    [
        (Market.Twse, "加權指數"),
        (Market.Tpex, "櫃買指數")
    ];

    /// <summary>
    /// 門檻的單位就是表格上那一欄「平均每日成交值」，按鈕上的金額可以直接跟表格對照。
    /// 期間長度不影響門檻，換期間時排除的標準不會跟著跑掉。
    /// </summary>
    private static readonly decimal[] LiquidityOptions =
        [0m, 100_000_000m, 1_000_000_000m, 10_000_000_000m];

    /// <summary>
    /// 每一欄的算法寫在 Hint 裡，滑鼠停在標題上就看得到，
    /// 不必回頭翻 README 才知道這一格的數字怎麼來的。
    /// </summary>
    private static readonly SortColumn[] Columns =
    [
        new("rank", "排名",
            "依目前排行模式排序後的名次。成交熱度看本期平均每日成交值，資金加速看較前期增減。",
            row => row.Rank, Ascending: true),

        new("change", "排名變化",
            "前期排名 − 本期排名，▲ 代表名次上升。前期算不出名次時顯示 —。",
            row => row.RankChange),

        new("ticker", "代號",
            "只收一般股票：代號四位數字且不以 0 開頭。右側「市／櫃」標記代表上市或上櫃。",
            row => null, Ascending: true),

        new("name", "名稱", "點擊標的名稱會開啟最近三個月還原權息日 K 彈窗，不會改動排行表格；名稱取自證交所與櫃買中心的每日收盤行情。",
            row => null, Ascending: true),

        new("value", "平均每日成交值（億）",
            "期間總成交值 ÷ 期間交易日數。只計一般交易，零股、盤後定價與鉅額交易都已逐檔扣除。",
            row => row.AverageDailyTradingValue),

        new("rate", "較前期增減",
            "（本期平均 − 前期平均）÷ 前期平均。前期是緊鄰的同長度區間；前期為 0 時無法計算，顯示 — 並排在最後。",
            row => row.TradingValueChangeRate),

        new("share", "市場成交比",
            "個股期間成交值 ÷ 全市場期間成交值。分母固定是上市＋上櫃全體，不隨市場篩選改變，切換市場時比例才能互相比較。",
            row => row.MarketShare),

        new("shareChange", "成交比變化",
            "本期市場成交比 − 前期市場成交比，單位是百分點。",
            row => row.MarketShareChange),

        new("price", "漲跌幅",
            "上層「日」是所選交易日相對前一個有效收盤價；下層「週」是相對本週開始前最後有效收盤價。點擊排序仍以日漲跌幅為準。",
            row => row.DailyPriceChangeRate),

        new("close", "收盤價", "期間最後一個交易日的收盤價。", row => row.ClosePrice)
    ];

    private RankingQuery _query = new();
    private TradingValueRankingResult? _result;
    private MarketDataSet _dataSet = MarketDataSet.Empty;
    private IReadOnlyList<DateOnly> _tradingDates = [];
    private IReadOnlyDictionary<DateOnly, IReadOnlyList<MarketIndexQuote>> _marketIndices =
        new Dictionary<DateOnly, IReadOnlyList<MarketIndexQuote>>();
    private bool _loading = true;
    private string _sortKey = "rank";
    private bool _sortDescending;

    /// <summary>
    /// 鎖定的股號。追蹤中的標的即使掉出前 100 名也要看得到現在排第幾，
    /// 進榜時整列標色，一眼就能在表格裡找到。
    /// </summary>
    private readonly List<string> _lockedTickers = [];

    private IReadOnlyDictionary<string, string> _stockNames = new Dictionary<string, string>();
    private string _lockInput = string.Empty;
    private string? _lockError;
    private string? _expandedTicker;

    protected override async Task OnInitializedAsync()
    {
        var dataSet = await RankingService.GetDataSetAsync();
        _dataSet = dataSet;

        _stockNames = dataSet.Stocks.ToDictionary(stock => stock.Ticker, stock => stock.Name);
        _marketIndices = dataSet.MarketIndices.ToDictionary(day => day.TradingDate, day => day.Quotes);
        _tradingDates = RankingDates.Selectable(dataSet.DailyTrading.Select(trading => trading.TradingDate));
        _query = _query with { EndDate = _tradingDates.Count > 0 ? _tradingDates[^1] : null };

        await ReloadAsync();
    }

    private DateOnly KLineEndDate
        => _query.EndDate ?? _tradingDates.LastOrDefault();

    private IReadOnlyList<DailyKLinePoint> KLineBars(string ticker)
        => _dataSet.DailyTrading.Count == 0
            ? []
            : DailyKLineSelector.Select(
                _dataSet.DailyTrading,
                _dataSet.PriceAdjustments,
                ticker,
                KLineEndDate,
                _dataSet.DailyTrading.Max(row => row.TradingDate));

    private void ToggleKLine(string ticker)
        => _expandedTicker = _expandedTicker == ticker ? null : ticker;

    private void CloseKLine()
        => _expandedTicker = null;

    private StockRankingRow? ExpandedKLineRow
        => _expandedTicker is { } ticker
            ? _result?.Rows.FirstOrDefault(row => row.Ticker == ticker)
            : null;

    private IEnumerable<StockRankingRow> SortedRows
    {
        get
        {
            IReadOnlyList<StockRankingRow> rows = _result?.Rows ?? [];
            var column = Columns.FirstOrDefault(candidate => candidate.Key == _sortKey);

            if (column is null)
            {
                return rows;
            }

            // 代號、名稱是文字，走另一條排序路徑。
            if (column.Key is "ticker" or "name")
            {
                Func<StockRankingRow, string> text = column.Key == "ticker"
                    ? row => row.Ticker
                    : row => row.Name;

                return _sortDescending
                    ? rows.OrderByDescending(text, StringComparer.Ordinal)
                    : rows.OrderBy(text, StringComparer.Ordinal);
            }

            // 無法計算的欄位（例如前期為 0 的增減率）一律沉到最後，不論升冪降冪。
            var ordered = rows.OrderBy(row => column.Value(row) is null ? 1 : 0);

            return _sortDescending
                ? ordered.ThenByDescending(row => column.Value(row) ?? 0m).ThenBy(row => row.Rank)
                : ordered.ThenBy(row => column.Value(row) ?? 0m).ThenBy(row => row.Rank);
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _result = await RankingService.GetRankingAsync(_query);
        _loading = false;
    }

    private Task ChangePeriodAsync(int periodDays)
    {
        _query = _query with { PeriodDays = periodDays };
        return ReloadAsync();
    }

    private Task ChangeEndDateAsync(DateOnly date)
    {
        _query = _query with { EndDate = date };
        return ReloadAsync();
    }

    private Task ChangeModeAsync(RankingMode mode)
    {
        _query = _query with { Mode = mode };
        return ReloadAsync();
    }

    private Task ChangeMarketAsync(MarketFilter market)
    {
        _query = _query with { Market = market };
        return ReloadAsync();
    }

    private Task ChangeLiquidityAsync(decimal threshold)
    {
        _query = _query with { MinimumAverageDailyTradingValue = threshold };
        return ReloadAsync();
    }

    private IReadOnlyList<MarketIndexQuote> SelectedMarketIndices
        => _query.EndDate is { } date && _marketIndices.TryGetValue(date, out var indices)
            ? indices
            : [];

