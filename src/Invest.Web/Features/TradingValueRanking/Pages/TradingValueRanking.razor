        };

    private static string HeatProgressWidth(decimal? score)
        => score is { } value
            ? $"{Math.Clamp(value * 10m, 0m, 100m):0.##}%"
            : "0%";

    private static string HeatPercentText(decimal? percent)
        => percent is { } value
            ? RankingFormatter.ToSignedPercentText(value / 100m, 2)
            : "—";

    private static string HeatVolumeText(decimal? ratio)
        => ratio is { } value ? $"{value:N2} × 20 日均量" : "—";

    private static string HeatTurnoverText(decimal? turnover)
        => turnover is { } value ? RankingFormatter.ToBillionText(value, 2) : "—";

    private static decimal? IndexChangeRate(MarketIndexQuote? index)
        => index?.ChangePercent is { } changePercent ? changePercent / 100m : null;

    private static string IndexPointSuffix(MarketIndexQuote? index, decimal? rate)
    {
        var points = index is null || rate is not { } value
            ? null
            : MarketIndexPerformanceCalculator.PointChange(index.Value, value * 100m);

        return points is null
            ? string.Empty
            : $"（{RankingFormatter.ToSignedIndexPointText(points)}）";
