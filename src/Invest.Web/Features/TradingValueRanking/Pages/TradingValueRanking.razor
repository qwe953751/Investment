    private decimal? IndexYearToDateRate(MarketIndexQuote? index)
    {
        if (index is null || _query.EndDate is not { } date)
        {
            return null;
        }

        var changePercent = MarketIndexPerformanceCalculator.YearToDateChangePercent(
            _dataSet.MarketIndices,
            date,
            index.Market);

        return changePercent / 100m;
