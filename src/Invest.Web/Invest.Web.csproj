<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- 行情解析的細節（欄位剖析、非一般交易的累加）是 internal，但正是最需要測試的部分。 -->
    <InternalsVisibleTo Include="Invest.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 靜態網站的頁面檔案。內嵌進組件，export 指令才不必猜工作目錄在哪。 -->
    <EmbeddedResource Include="Infrastructure/StaticSite/Assets/*" />

    <!-- 概念股歸類表（版本二）。跟頁面檔案一樣內嵌，export 才不必猜工作目錄在哪。 -->
    <EmbeddedResource Include="Features/StockTopics/ConceptMapping.json" />

    <!-- 查證過的失效成員個股（下市、被併購、興櫃）。同上，內嵌才不必猜工作目錄。 -->
    <EmbeddedResource Include="Features/StockTopics/MemberStatus.json" />

    <!-- 族群樹上使用者拍板過的結構調整。F:J 樹每次匯出都從 Google Sheet 重讀，調整只能記在這裡再套一次。 -->
    <EmbeddedResource Include="Features/StockTopics/TopicTreeOverrides.json" />

    <!-- 補分類：把原本一檔成員都沒有的族群節點填起來。同樣是每次匯出重讀樹之後再套一次。 -->
    <EmbeddedResource Include="Features/StockTopics/TopicMemberOverrides.json" />

    <!-- 產業別代碼要掛到哪個族群節點。分類的最後兜底，同樣得跟著組件走。 -->
    <EmbeddedResource Include="Features/StockTopics/IndustryTopicMap.json" />

    <!-- 說明泡泡兩邊都要用：Blazor 頁面直接從 wwwroot 載，靜態網站則靠這裡內嵌後輸出。
         同一份檔案掛兩個身分，才不會改了一邊忘了另一邊。 -->
    <EmbeddedResource Include="wwwroot/hint.js" LogicalName="Invest.Web.Infrastructure.StaticSite.Assets.hint.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
