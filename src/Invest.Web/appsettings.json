{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 族群分類的資料來源。預設以 Supabase 為權威（Source=supabase），Google Sheet 只當唯讀備份。
  // 切換至 Source=sheet 時會重新讀取 Google Sheet 並覆寫 Supabase 快取（緊急重新匯入用）。
  // SpreadsheetId / TreeGid / ConceptSheetName 保留以供切換時使用。
  "StockTopics": {
    "Source": "supabase",
    "SpreadsheetId": "1rZpWz5GSHkvjoXlp5mX6SKoe2Yhn0MMfNfiiqTpDpZI",
    "TreeGid": "1904081347",
    "ConceptSheetName": "概念股"
  },

  "AssetOperationSheet": {
    "SpreadsheetId": "1rZpWz5GSHkvjoXlp5mX6SKoe2Yhn0MMfNfiiqTpDpZI",
    "SheetName": "操作(台)"
  },

  // 靜態網站的盤中頁直接讀 Supabase，這兩個值會被寫進 manifest.json 送到瀏覽器。
  // AnonKey 本來就是設計成公開的：它只有 select 權限（見 db/001_intraday.sql 的 RLS），
  // 而且發佈到 gh-pages 之後任何人都看得到，藏起來沒有意義。寫入用的是另一組連線字串。
  "Supabase": {
    "Url": "https://dehzxlxyfvtnylwgbmqy.supabase.co",
    "AnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRlaHp4bHh5ZnZ0bnlsd2dibXF5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3ODUyODksImV4cCI6MjEwMjM2MTI4OX0.LJ32BkKu00Dw800W05p1MDWmSrPEhQ0EAMwPCJfpqCw"
  },

  // 只保存可公開的盤中行情版本檔與 latest 指標。bucket 必須是 public；上傳需要的
  // SUPABASE_STORAGE_SECRET_KEY 只放 GitHub Secrets 或本機環境變數，絕不能寫在這裡。
  "IntradayCdn": {
    "Bucket": "intraday-snapshots",
    "RetainedSnapshotCount": 30
  },

  // 日／韓只保存指數、風險與產業代表的 5 分鐘快照，刻意與台股全市場快照分 bucket。
  // 收集器首次成功時會以 SUPABASE_STORAGE_SECRET_KEY 建立 public bucket；前端只讀公開 URL，
  // 不會輪詢 PostgreSQL。來源目前是無 SLA 的 Yahoo chart API，缺值時保留前一完整快照。
  "MarketOverviewIntradayCdn": {
    "Bucket": "market-overview-intraday-snapshots",
    "RetainedSnapshotCount": 30
  },

  // 全市場成交金額前 20 的來源只由 GitHub Actions／collector 呼叫；瀏覽器不直連。
  // 金鑰僅放 KIS_APP_KEY、KIS_APP_SECRET、MASSIVE_API_KEY 環境變數。
  "KisMarketData": {
    "BaseUrl": "https://openapi.koreainvestment.com:9443",
    "AppKeyEnvironmentVariable": "KIS_APP_KEY",
    "AppSecretEnvironmentVariable": "KIS_APP_SECRET",
    "RequestDelayMilliseconds": 300
  },
  "MassiveMarketData": {
    "BaseUrl": "https://api.massive.com",
    "ApiKeyEnvironmentVariable": "MASSIVE_API_KEY"
  },

  // 來源授權與公開再分發確認前維持 false；即使誤設 public，仍需 Storage secret。
  "MarketTurnoverCdn": {
    "Bucket": "market-turnover-snapshots",
    "Public": false,
    "RetainedSnapshotCount": 30
  }
}
